{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/verify-web-build.mjs",
  "outputDirectory": "web",
  "headers": [
    {
      "source": "/rustcraft.wasm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
